# Claude Agent SDK 环境变量配置
# 文档：https://platform.claude.com/docs/en/agent-sdk/overview

# ===========================================
# 方式一：使用 Anthropic API（推荐）
# ===========================================
# 获取 API 密钥：https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# 方式二：使用 Amazon Bedrock
# ===========================================
# 设置此变量使用 Bedrock，需要配置 AWS 凭证
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret

# ===========================================
# 方式三：使用 Google Vertex AI
# ===========================================
# 设置此变量使用 Vertex AI，需要配置 Google Cloud 凭证
# CLAUDE_CODE_USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=your_project_id
# GOOGLE_CLOUD_LOCATION=us-central1

# ===========================================
# 方式四：使用 Azure AI Foundry
# ===========================================
# 设置此变量使用 Azure，需要配置 Azure 凭证
# CLAUDE_CODE_USE_FOUNDRY=1
# AZURE_ENDPOINT=your_azure_endpoint
# AZURE_API_KEY=your_azure_key

# ===========================================
# 可选配置
# ===========================================
# 指定模型版本（可选，默认使用最新）
# CLAUDE_CODE_MODEL=claude-sonnet-4-6-20250929
